DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — error monitoring. Leave blank to disable (app runs fine without it).
# SENTRY_DSN turns on server-side error reporting; SENTRY_AUTH_TOKEN (build-time
# only, set in Vercel) uploads source maps for readable stack traces.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
