# Installed inside the image (deps stage) — never copy the host's copy.
node_modules
**/node_modules

# Build output — regenerated by `next build` in the image.
.next
out
build

# Secrets / local env — must never be baked into the image.
.env
.env.*
!.env.local.example

# VCS and CI metadata.
.git
.gitignore
.github

# Python virtualenv used by the scraping scripts.
scripts/.venv

# Docker files and local tooling.
Dockerfile
.dockerignore

# Editor / OS cruft.
.DS_Store
*.pem
npm-debug.log*
.pnpm-debug.log*
coverage
.vercel
*.tsbuildinfo
